[run]
branch = True
relative_files = True
source =
    src

[paths]
# Normalize Windows/macOS/Linux path variants to the same logical source root
source =
    src
    */src
    *\src

[report]
omit =
    tests/*
    */__init__.py
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

[xml]
output = coverage.xml
